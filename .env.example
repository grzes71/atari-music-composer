# =============================================================================
# Atari Music / DeepSeek Integration — Example Environment Template
# Skopiuj ten plik do .env i uzupełnij własnym kluczem API.
# =============================================================================

# Klucz API DeepSeek (wymagany do autoryzacji zapytań)
DEEPSEEK_API_KEY=your_api_key_here

# Bazowy adres URL API DeepSeek (domyślnie oficjalny endpoint REST)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Nazwa modelu DeepSeek używanego do wnioskowania/kompozycji (np. deepseek-flash, deepseek-chat, deepseek-coder)
DEEPSEEK_MODEL=deepseek-flash

# Poziom logowania aplikacji (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
