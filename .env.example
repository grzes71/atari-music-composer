# =============================================================================
# Atari Music — AI Configuration Template
# Skopiuj ten plik do .env (lub wskaż opcją --env-file) i uzupełnij klucz API.
# =============================================================================

# Dostawca AI (np. deepseek, openai, mock)
AI_PROVIDER=deepseek

# Klucz API dostawcy AI (wymagany do zapytań produkcyjnych)
# Kompatybilność wsteczna: system automatycznie odczytuje także DEEPSEEK_API_KEY i OPENAI_API_KEY
AI_API_KEY=your_api_key_here

# Bazowy adres URL punktu końcowego API dostawcy AI
AI_BASE_URL=https://api.deepseek.com

# Nazwa modelu używanego do wnioskowania i kompozycji muzycznej (np. deepseek-flash)
AI_MODEL=deepseek-flash

# Poziom logowania aplikacji (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
