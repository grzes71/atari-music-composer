  "metadata": {
    "title": "The Obsidian Crown",
    "author": "AI Composer",
    "description": null,
    "key": "D",
    "mode": "minor",
    "bpm": 60,
    "duration_seconds": 92.2
  },
  "form_plan": {
    "form_type": "A-B-A",
    "primary_theme_description": "A solemn D-minor recorder theme that sinks stepwise from the fifth through the sixth, fourth and fifth degrees, harmonised over a descending 16-bit bass of D-Bb-G-A. A sparse harp arpeggio outlines each chord beneath it.",
    "contrast_theme_description": null,
    "sections": [
      {
        "section_id": "Intro",
        "pattern_id": "intro",
        "role": "intro",
        "variation_of": null,
        "description": "D pedal drone with a fragmented harp figure and the first hushed statement of the theme head, ending on a suspended C5."
      },
      {
        "section_id": "A1",
        "pattern_id": "A1",
        "role": "theme",
        "variation_of": null,
        "description": "Full statement of the dark theme over i-VI-iv-V with a continuous harp arpeggio on channel 3."
      },
      {
        "section_id": "A2",
        "pattern_id": "A2",
        "role": "theme_variation",
        "variation_of": null,
        "description": "Lifted variant of the theme with faster sixteenth movement over i-VI-VII-V; the harp gives way to a low viola counter-line."
      },
      {
        "section_id": "B1",
        "pattern_id": "B1",
        "role": "bridge",
        "variation_of": null,
        "description": "War-drum bridge in a lower register, chords VI-III-iv-V; the lead becomes martial and repetitive."
      },
      {
        "section_id": "B2",
        "pattern_id": "B2",
        "role": "bridge",
        "variation_of": null,
        "description": "Second half of the bridge: drums drop out for a two-voice dialogue between lead and counter, building toward the return."
      },
      {
        "section_id": "A3",
        "pattern_id": "A3",
        "role": "recapitulation",
        "variation_of": null,
        "description": "Climactic return of the theme with an ornamented lead and the fullest harp arpeggios, cadencing on a suspended D5."
      },
      {
        "section_id": "Coda",
        "pattern_id": "coda",
        "role": "coda",
        "variation_of": null,
        "description": "The harp descends through the D-minor triad while the lead holds the octave; everything fades to a bare tonic."
      }
    ]
  },
