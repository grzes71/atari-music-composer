  "form_plan": {
    "form_type": "A-B-A",
    "primary_theme_description": "A solemn Aeolian lament in A minor: a dotted-rhythm descending motif (E-D-C-B) answered by a rising climactic phrase (E-F-G-E) that falls back to the tonic over a stone-heavy bass.",
    "contrast_theme_description": null,
    "sections": [
      {
        "section_id": "Intro",
        "pattern_id": "pat_intro",
        "role": "intro",
        "variation_of": null,
        "description": "Sparse two-bar lament over an A drone, distant bell chimes, no percussion or harmony."
      },
      {
        "section_id": "A1",
        "pattern_id": "pat_A1",
        "role": "theme",
        "variation_of": null,
        "description": "First statement of the main theme: melody alone with slow whole-note bass and a heartbeat drum."
      },
      {
        "section_id": "A2",
        "pattern_id": "pat_A2",
        "role": "theme",
        "variation_of": null,
        "description": "Theme continuation; the Shadow Choir enters with a slow counter-line, bass moves in half notes, closing on the leading tone G#."
      },
      {
        "section_id": "B1",
        "pattern_id": "pat_B1",
        "role": "contrast",
        "variation_of": null,
        "description": "Phrygian shift with Bb; a stark martial march of repeated bass pulses and drum cadence, harmony voice silent."
      },
      {
        "section_id": "B2",
        "pattern_id": "pat_B2",
        "role": "contrast",
        "variation_of": null,
        "description": "Intensification of B; counter-melody returns, melody climbs to E5 and cadences on an E7 dominant."
      },
      {
        "section_id": "A3",
        "pattern_id": "pat_A3",
        "role": "theme",
        "variation_of": null,
        "description": "Full return of the theme with walking bass, Shadow Choir accompaniment and the heaviest drum cadence."
      },
      {
        "section_id": "Coda",
        "pattern_id": "pat_coda",
        "role": "coda",
        "variation_of": null,
        "description": "Two-second open A minor resolution with a final distant bell."
      }
    ]
  },
